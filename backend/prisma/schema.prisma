
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  ENTRY
  EXIT
  LOSS
  ADJUSTMENT
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum PurchaseStatus {
  CONFIRMED
}


model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  active      Boolean   @default(true)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  quantity      Float     @default(0)
  unit          String
  unitPrice     Decimal   @db.Decimal(10, 2)
  minimumStock  Float     @default(0)
  active        Boolean   @default(true)
  description   String?

  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  movements     Movement[]
  purchaseItems PurchaseItem[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  document    String    @unique
  contactName String
  phone       String
  email       String
  address     String
  active      Boolean   @default(true)

  purchases   Purchase[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model Purchase {
  id         Int            @id @default(autoincrement())
  date       DateTime       @default(now())
  total      Decimal        @db.Decimal(12, 2)
  status     PurchaseStatus @default(CONFIRMED)

  supplierId Int
  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items      PurchaseItem[]

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  quantity   Float
  unitPrice  Decimal  @db.Decimal(10, 2)

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}


model Movement {
  id               Int          @id @default(autoincrement())
  type             MovementType
  quantity         Float
  previousQuantity Float
  newQuantity      Float
  date             DateTime     @default(now())
  responsible      String
  reason           String

  productId        Int
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt        DateTime     @default(now())
}


model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  phone        String
  passwordHash String
  role         UserRole  @default(OPERATOR)
  active       Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

